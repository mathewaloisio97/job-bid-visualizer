{
  "name": "job-bid-visualizer",
  "version": "1.0.0",
  "description": "Stateless ERP middleware for real-time bid visualization",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "format": "prettier --write \"**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs}\"",
    "test:snapshot": "node scripts/test-snapshot.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "express": "^4.22.2",
